<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  
  <Package Name="Daily Task Manager"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="Smart Point"
           UpgradeCode="A7B2C3D4-E5F6-7890-ABCD-123456789012"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">
    
    <!-- Package Information -->
    <SummaryInformation Description="Daily Task Manager - Cross-platform task management application" />
    
    <!-- Media Template -->
    <MediaTemplate EmbedCab="yes" />
    
    <!-- Enhanced Major Upgrade Configuration -->
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall the newer version first."
      AllowDowngrades="no"
      AllowSameVersionUpgrades="yes"
      MigrateFeatures="yes" />
    
    <!-- Feature Definition -->
    <Feature Id="ProductFeature" Title="Daily Task Manager Application" Level="1" Description="Core application files">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
    </Feature>
    
    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1000" Description="Creates a shortcut on the desktop">
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>
    
    <!-- Installation Directory Structure -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="CompanyFolder" Name="SmartPoint">
        <Directory Id="INSTALLFOLDER" Name="DailyTaskManager" />
      </Directory>
    </StandardDirectory>
    
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Daily Task Manager" />
    </StandardDirectory>
    
    <StandardDirectory Id="DesktopFolder" />
    
    <!-- Application Components -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      
      <!-- Main Executable -->
      <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7B8C-9D0E-123456789ABC">
        <File Id="DailyTaskManagerExe" 
              Name="DailyTaskManager.Avalonia.exe" 
              Source="$(var.PublishDir)\DailyTaskManager.Avalonia.exe"
              KeyPath="yes" />
      </Component>
      
      <!-- Configuration Files -->
      <Component Id="ConfigurationFiles" Guid="C2D3E4F5-A6B7-8C9D-0E1F-234567890BCD">
        <File Id="AppSettingsJson" 
              Name="appsettings.json" 
              Source="$(var.PublishDir)\appsettings.json"
              KeyPath="yes" />
      </Component>
      
      <Component Id="DevConfigFiles" Guid="D3E4F5A6-B7C8-9D0E-1F2A-34567890CDEF">
        <File Id="AppSettingsDevJson" 
              Name="appsettings.Development.json" 
              Source="$(var.PublishDir)\appsettings.Development.json"
              KeyPath="yes" />
      </Component>
      
      <!-- Installation Registry Information -->
      <Component Id="RegistryEntries" Guid="A1B2C3D4-E5F6-7890-1234-567890ABCDEF">
        <RegistryKey Root="HKLM" Key="SOFTWARE\SmartPoint\DailyTaskManager">
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" KeyPath="yes" />
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="InstallDate" Type="string" Value="[Date]" />
          <RegistryValue Name="ReleaseChannel" Type="string" Value="[RELEASECHANNEL]" />
          <RegistryValue Name="InstallMode" Type="string" Value="automatic" />
          <RegistryValue Name="UpdatesEnabled" Type="integer" Value="1" />
        </RegistryKey>
        
        <!-- Uninstall Registry Entry -->
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]">
          <RegistryValue Name="EstimatedSize" Type="integer" Value="50000" />
          <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="Publisher" Type="string" Value="Smart Point" />
          <RegistryValue Name="DisplayVersion" Type="string" Value="$(var.Version)" />
          <RegistryValue Name="VersionMajor" Type="integer" Value="2" />
          <RegistryValue Name="VersionMinor" Type="integer" Value="1" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
    
    <!-- Start Menu Shortcuts -->
    <ComponentGroup Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationStartMenuShortcut" Guid="E4F5A6B7-C8D9-0E1F-2A3B-456789CDEF01">
        <Shortcut Id="ApplicationStartMenuShortcutId"
                  Name="Daily Task Manager"
                  Target="[INSTALLFOLDER]DailyTaskManager.Avalonia.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        
        <!-- Uninstall Shortcut -->
        <Shortcut Id="UninstallProduct"
                  Name="Uninstall Daily Task Manager"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" 
                       Key="Software\SmartPoint\DailyTaskManager" 
                       Name="installed" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <!-- Desktop Shortcuts -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="F5A6B7C8-D9E0-1F2A-3B4C-56789DEF0123">
        <Shortcut Id="DesktopShortcutId"
                  Name="Daily Task Manager"
                  Target="[INSTALLFOLDER]DailyTaskManager.Avalonia.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" 
                       Key="Software\SmartPoint\DailyTaskManager" 
                       Name="desktop_shortcut" 
                       Type="integer" 
                       Value="1" 
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <!-- Add/Remove Programs Information -->
    <Property Id="ARPHELPLINK" Value="https://github.com/smartpointdevelopment/DailyTaskManager" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/smartpointdevelopment/DailyTaskManager" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    
    <!-- Launch Conditions -->
    <Launch Condition="VersionNT >= 601" Message="This application requires Windows 7 or higher." />
    <Launch Condition="VersionNT64" Message="This application requires a 64-bit version of Windows." />
    
    <!-- Version Validation Properties -->
    <Property Id="PREVIOUSVERSIONINSTALLED" Secure="yes" />
    <Property Id="NEWPRODUCTFOUND" Secure="yes" />
    
    <!-- Installation Mode Properties -->
    <Property Id="INSTALLMODE">
      <RegistrySearch Id="InstallModeSearch"
                      Root="HKLM" 
                      Key="SOFTWARE\SmartPoint\DailyTaskManager"
                      Name="InstallMode"
                      Type="raw" />
    </Property>
    
    <!-- Release Channel Property -->
    <Property Id="RELEASECHANNEL" Value="stable">
      <RegistrySearch Id="ReleaseChannelSearch"
                      Root="HKLM" 
                      Key="SOFTWARE\SmartPoint\DailyTaskManager"
                      Name="ReleaseChannel"
                      Type="raw" />
    </Property>
    
    <!-- Remove the background reminder task the app registered for the current user when the app is uninstalled -->
    <CustomAction Id="RemoveReminderTask"
                  Directory="TARGETDIR"
                  ExeCommand="schtasks.exe /Delete /TN &quot;DailyTaskManager\Reminder&quot; /F"
                  Execute="immediate"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveReminderTask" After="InstallInitialize" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- Previous Version Property -->
    <Property Id="PREVVERSION">
      <RegistrySearch Id="PrevVersionSearch"
                      Root="HKLM" 
                      Key="SOFTWARE\SmartPoint\DailyTaskManager"
                      Name="Version"
                      Type="raw" />
    </Property>
    
  </Package>
</Wix>