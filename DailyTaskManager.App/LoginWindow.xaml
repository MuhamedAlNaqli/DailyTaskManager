<Window x:Class="DailyTaskManager.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DailyTaskManager.App.ViewModels"
        Title="Daily Task Manager - Login"
        Height="750" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.DataContext>
        <viewModels:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <materialDesign:Card Padding="40" Margin="20">
            <StackPanel>
                <!-- Header -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <materialDesign:PackIcon Kind="ClipboardText" Width="32" Height="32" Margin="0,0,10,0" 
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="Daily Task Manager" 
                               FontSize="24" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>

                <!-- Mode Toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                            Click="LoginModeButton_Click"
                            x:Name="LoginModeButton"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Login" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Login" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                            Click="RegisterModeButton_Click"
                            x:Name="RegisterModeButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Register" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel x:Name="LoginForm" Visibility="Visible">
                    <TextBox materialDesign:HintAssist.Hint="Username"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,15"/>

                    <PasswordBox x:Name="LoginPasswordBox"
                                 materialDesign:HintAssist.Hint="Password"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Register Form -->
                <StackPanel x:Name="RegisterForm" Visibility="Collapsed">
                    <TextBox materialDesign:HintAssist.Hint="Username"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Email"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,15"/>

                    <PasswordBox x:Name="RegisterPasswordBox"
                                 materialDesign:HintAssist.Hint="Password"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,15"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 materialDesign:HintAssist.Hint="Confirm Password"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ValidationErrorBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,0,15"/>

                <!-- Action Buttons -->
                <Button x:Name="ActionButton"
                        Content="Login"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding CanExecute}"
                        Margin="0,0,0,20"/>

                <!-- Loading Indicator -->
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0"
                             IsIndeterminate="True"
                             Width="30"
                             Height="30"
                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Margin="0,0,0,20"/>

                <!-- OAuth Buttons -->
                <Separator Margin="0,10,0,20"/>
                
                <TextBlock Text="Or continue with:"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Margin="0,0,0,15"/>

                <StackPanel>
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                            Command="{Binding GoogleLoginCommand}"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Google" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Continue with Google" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                            Command="{Binding MicrosoftLoginCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Microsoft" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Continue with Microsoft" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
        </ScrollViewer>
    </Grid>
</Window>