<Window x:Class="DailyTaskManager.App.EditTaskWindow"  
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
       xmlns:controls="clr-namespace:DailyTaskManager.App.Controls"
       Title="Edit Task"
       WindowStartupLocation="CenterScreen"
       Background="{DynamicResource MaterialDesignPaper}"
        Width="450"
        Height="350"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <materialDesign:Card Padding="20" Grid.Column="0">
        <StackPanel>
            <controls:SpeechToTextControl 
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             HintText="Description (type or dictate)"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MaxLines="5"
                             Margin="0 0 0 15"
                             Height="100"/>

            <Grid Margin="0 0 0 15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <DatePicker materialDesign:HintAssist.Hint="Date" 
                                    SelectedDate="{Binding Date}"
                                    Style="{StaticResource MaterialDesignDatePicker}" />
                <TextBox Grid.Column="2" 
                                 Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 materialDesign:HintAssist.Hint="Hours" 
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Background="{DynamicResource PrimaryHueMidBrush}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10 5"
                                Margin="5 0 0 0"
                                Command="{Binding SubmitCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" Margin="0 0 3 0"/>
                        <TextBlock Text="Submit" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
