<Window x:Class="DailyTaskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewModels="clr-namespace:DailyTaskManager.App.ViewModels"
        xmlns:views="clr-namespace:DailyTaskManager.App.Views"
        Title="Daily Task Manager"
        Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignPaper}">
            <DockPanel LastChildFill="True">
                <!-- App header -->
                <Border DockPanel.Dock="Top" Height="64" Padding="16"
                        Background="{DynamicResource MaterialDesignPaper}">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClipboardText" Width="22" Height="22" Margin="0,0,8,0"/>
                            <TextBlock Text="Daily Task Manager"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="UserDisplayName" 
                                   Text="Welcome, User" 
                                   FontSize="10" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Nav -->
                <StackPanel Margin="8">
                    <StackPanel VerticalAlignment="Top">
                        <Button x:Name="BtnDailyTasks"
                                Click="BtnDailyTasks_Click"
                                Margin="0,4,0,0" Padding="10" Height="Auto">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarCheck" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Daily Tasks" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings"
                                Click="BtnSettings_Click"
                                Margin="0,4,0,0" Padding="10" Height="Auto">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Logout Button -->
                    <Button x:Name="BtnLogout"
                            Click="BtnLogout_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,20,0,0" 
                            Padding="10" 
                            Height="Auto"
                            Foreground="{DynamicResource ValidationErrorBrush}"
                            BorderBrush="{DynamicResource ValidationErrorBrush}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Logout" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content region -->
        <ContentControl x:Name="ContentRegion" Grid.Column="1"/>
    </Grid>
</Window>
