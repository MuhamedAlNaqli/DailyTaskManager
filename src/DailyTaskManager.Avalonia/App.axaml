<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="DailyTaskManager.Avalonia.App"
             RequestedThemeVariant="Light">
    
    <!-- Theme Configuration -->
    <Application.Styles>
        <!-- Material Avalonia Theme - Single instance that responds to RequestedThemeVariant -->
        <themes:MaterialTheme BaseTheme="Inherit" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
        
        <!-- Custom Application Styles -->
        <StyleInclude Source="Styles/App.axaml"/>
    </Application.Styles>

    <!-- Global Resources -->
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Common Values -->
            <Thickness x:Key="DefaultMargin">16</Thickness>
            <Thickness x:Key="DefaultPadding">16</Thickness>
            <x:Double x:Key="HeaderFontSize">24</x:Double>
            <x:Double x:Key="SubHeaderFontSize">18</x:Double>
            
            <!-- Common Brushes -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#2196F3"/>
            
            <!-- Additional Margins and Paddings -->
            <Thickness x:Key="SmallMargin">5</Thickness>
            <Thickness x:Key="SmallPadding">8</Thickness>
            
            <!-- Additional Font Sizes -->
            <x:Double x:Key="NormalFontSize">14</x:Double>
            <x:Double x:Key="SmallFontSize">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>