{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=DailyTaskManager;Username=postgres;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AppSettings": {
    "ApplicationName": "Daily Task Manager",
    "Version": "3.5.0",
    "DefaultTheme": "Light",
    "AutoSave": true,
    "AutoSaveInterval": 300,
    "DefaultHours": 7.0,
    "DateFormat": "yyyy-MM-dd",
    "ExportPath": "~/Desktop"
  },
  "OAuth": {
    "Google": {
      "ClientId": "your_google_client_id_here",
      "ClientSecret": "your_google_client_secret_here"
    },
    "Microsoft": {
      "ClientId": "your_microsoft_client_id_here",
      "ClientSecret": "your_microsoft_client_secret_here"
    }
  },
  "Features": {
    "SpeechRecognition": true,
    "PDFExport": true,
    "ExcelExport": true,
    "DarkTheme": true,
    "OAuth": true
  },
  "UpdateService": {
    "AppCastUrl": "https://github.com/MuhamedAlNaqli/DailyTaskManager/releases/latest/download/appcast.xml",
    "ApplicationName": "Daily Task Manager",
    "CompanyName": "Smart Point",
    "AutoUpdatesEnabled": true,
    "CheckInterval": "24:00:00"
  }
}
