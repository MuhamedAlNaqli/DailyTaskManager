<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        x:Class="DailyTaskManager.Avalonia.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Daily Task Manager - Login"
        Width="400" Height="580"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="{DynamicResource AppSurface}"
        CornerRadius="12">

    <Design.DataContext>
        <vm:LoginViewModel />
    </Design.DataContext>

    <Grid Margin="32">
        <StackPanel Spacing="16">
            
            <!-- Header -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Border Background="{DynamicResource AppAccent}" 
                        Width="48" 
                        Height="48" 
                        CornerRadius="24"
                        HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CalendarCheck" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Daily Task Manager" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AppTextStrong}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sign in to your account" 
                               FontSize="13" 
                               Foreground="{DynamicResource AppTextMuted}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Login Form -->
            <StackPanel Spacing="12">
                
                <!-- Username -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Username" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource AppText}"/>
                    <TextBox Classes="filled" Text="{Binding Username}"
                             Watermark="Enter your username"
                             Padding="12,10"
                             FontSize="13"
                             Name="UsernameTextBox"/>
                </StackPanel>
                
                <!-- Password -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Password" 
                               FontSize="13" 
                               FontWeight="Medium" 
                               Foreground="{DynamicResource AppText}"/>
                    <TextBox Classes="filled" Text="{Binding Password}"
                             Watermark="Enter your password"
                             PasswordChar="●"
                             Padding="12,10"
                             FontSize="13"
                             Name="PasswordTextBox"/>
                </StackPanel>
                
                <!-- Remember Me -->
                <CheckBox Content="Remember me" 
                          IsChecked="{Binding RememberMe}"
                          Foreground="{DynamicResource AppText}"
                          FontSize="13"/>
                
                <!-- Message -->
                <Border Background="{DynamicResource AppAccent}" 
                        CornerRadius="6" 
                        Padding="10,6"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               FontSize="13" 
                               Foreground="White"/>
                </Border>
                
                <!-- Login Button -->
                <Button Command="{Binding LoginCommand}"
                        Classes="primary"
                        Background="{DynamicResource AppAccent}"
                        BorderBrush="Transparent"
                        Foreground="White"
                        CornerRadius="6"
                        Padding="0,10"
                        FontSize="13"
                        FontWeight="Medium"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsLoading}"
                        IsDefault="True"
                        Name="SignInButton">
                    <Grid>
                        <TextBlock Text="Sign In" 
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding !IsLoading}"/>
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Spacing="6"
                                   IsVisible="{Binding IsLoading}">
                            <ProgressBar IsIndeterminate="True" 
                                        Width="14" 
                                        Height="14"/>
                            <TextBlock Text="Signing in..." FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </StackPanel>

            <!-- Divider -->
            <Grid>
                <Border Height="1" 
                        Background="{DynamicResource AppBorder}" 
                        VerticalAlignment="Center"/>
                <Border Background="{DynamicResource AppSurface}" 
                        Padding="12,0" 
                        HorizontalAlignment="Center">
                    <TextBlock Text="Or continue with" 
                               FontSize="12" 
                               Foreground="{DynamicResource AppTextMuted}"/>
                </Border>
            </Grid>

            <!-- OAuth Buttons -->
            <StackPanel Spacing="8">
                
                <!-- Google Login -->
                <Button Command="{Binding LoginWithGoogleCommand}"
                        Background="{DynamicResource AppSurface}"
                        BorderBrush="{DynamicResource AppBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="0,10"
                        FontSize="13"
                        FontWeight="Medium"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsLoading}">
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center" 
                               Spacing="8">
                        <Border Background="#FF4285F4" 
                                Width="18" 
                                Height="18" 
                                CornerRadius="9">
                            <TextBlock Text="G" 
                                       FontWeight="Bold" 
                                       FontSize="11"
                                       Foreground="White"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Continue with Google" 
                                   Foreground="{DynamicResource AppText}" 
                                   VerticalAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Footer -->
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="Don't have an account?" 
                           FontSize="12" 
                           Foreground="{DynamicResource AppTextMuted}"
                           HorizontalAlignment="Center"/>
                <Button Command="{Binding RegisterCommand}"
                        Classes="secondary"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Foreground="{DynamicResource AppAccent}"
                        Padding="0"
                        FontSize="12">
                    <TextBlock Text="Create Account"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>