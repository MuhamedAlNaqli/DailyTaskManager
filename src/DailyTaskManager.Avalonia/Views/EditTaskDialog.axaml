<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        x:Class="DailyTaskManager.Avalonia.Views.EditTaskDialog"
        x:DataType="vm:EditTaskViewModel"
        Title="Edit Task"
        Width="450"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:EditTaskViewModel/>
    </Design.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Edit Daily Task"
                   Classes="title"
                   Margin="0,0,0,20"/>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Spacing="15">
            
            <!-- Task Description -->
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,5">
                    <TextBlock Grid.Column="0"
                               Text="Description *"
                               Classes="label"
                               VerticalAlignment="Center"/>
                    <Button Name="DictateButton"
                            Grid.Column="1"
                            Command="{Binding Dictation.ToggleCommand}"
                            Content="{Binding Dictation.ButtonText}"
                            IsVisible="{Binding Dictation.IsAvailable}"
                            Padding="10,3"
                            FontSize="12"
                            CornerRadius="6"
                            ToolTip.Tip="Dictate the description with your microphone"/>
                    <TextBlock Name="DictationStatusText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Dictation.Status}"
                               IsVisible="{Binding !!Dictation.Status}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextMuted}"/>
                </Grid>
                <TextBox Text="{Binding Description}" 
                         Watermark="Enter task description (supports multiple lines)"
                         Classes="primary"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="80"
                         MaxHeight="200"
                         VerticalAlignment="Stretch"/>
            </StackPanel>

            <!-- Client -->
            <StackPanel>
                <TextBlock Text="Client"
                           Classes="label"
                           Margin="0,0,0,5"/>
                <Grid ColumnDefinitions="*,10,*">
                    <ComboBox Name="ClientComboBox"
                              Grid.Column="0"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientChoice">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Name="NewClientTextBox"
                             Grid.Column="2"
                             Text="{Binding NewClientName}"
                             Watermark="Or type a new client"
                             Classes="primary"/>
                </Grid>
            </StackPanel>

            <!-- Date and Hours -->
            <Grid ColumnDefinitions="*,10,120">
                
                <!-- Date -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date *" 
                               Classes="label" 
                               Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Date, Mode=TwoWay}"
                                Classes="primary"/>
                </StackPanel>

                <!-- Hours -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hours *" 
                               Classes="label" 
                               Margin="0,0,0,5"/>
                    <NumericUpDown Value="{Binding Hours}" 
                                   Minimum="0" 
                                   Maximum="24" 
                                   Increment="0.5" 
                                   FormatString="0.0"
                                   Classes="primary"/>
                </StackPanel>
            </Grid>

            <!-- Validation Message -->
            <TextBlock Text="{Binding ValidationMessage}" 
                       Classes="error" 
                       IsVisible="{Binding HasValidationError}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Action Buttons - Fixed positioning to avoid overlap -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10"
                    Margin="0,25,0,0">
            
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorderStrong}"
                    BorderThickness="1"
                    Foreground="{DynamicResource AppText}"
                    CornerRadius="6"
                    Padding="16,8"
                    MinWidth="90"/>
                    
            <Button Content="Save Changes" 
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Background="#FF4C566A"
                    BorderBrush="Transparent"
                    Foreground="White"
                    CornerRadius="6"
                    Padding="16,8"
                    FontWeight="Medium"
                    MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>