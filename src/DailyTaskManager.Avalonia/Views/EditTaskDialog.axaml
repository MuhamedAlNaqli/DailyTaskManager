<Window xmlns:materialIcons="using:Material.Icons.Avalonia" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        x:Class="DailyTaskManager.Avalonia.Views.EditTaskDialog"
        x:DataType="vm:EditTaskViewModel"
        Title="Edit Task"
        Width="540"
        MinWidth="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:EditTaskViewModel/>
    </Design.DataContext>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Edit Daily Task"
                   Classes="title"
                   Margin="0,0,0,22"/>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Spacing="18">
            
            <!-- Task Description -->
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0"
                               Text="Description *"
                               Classes="label"
                               VerticalAlignment="Center"/>
                    <Button Name="DictateButton"
                            Grid.Column="1"
                            Command="{Binding Dictation.ToggleCommand}"
                            IsVisible="{Binding Dictation.IsAvailable}"
                            Padding="10,3"
                            FontSize="12"
                            CornerRadius="6"
                            ToolTip.Tip="Dictate the description with your microphone">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="{Binding Dictation.IconKind}" Width="16" Height="16"/>
                            <TextBlock Text="{Binding Dictation.ButtonText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Name="DictationStatusText"
                               Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Dictation.Status}"
                               IsVisible="{Binding !!Dictation.Status}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextMuted}"/>
                </Grid>
                <TextBox Text="{Binding Description}" 
                         Watermark="Enter task description (supports multiple lines)"
                         Classes="filled"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="88"
                         MaxHeight="200"
                         VerticalAlignment="Stretch"/>
            </StackPanel>

            <!-- Date and Hours: two equal columns -->
            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date *" Classes="label" Margin="0,0,0,6"/>
                    <DatePicker Classes="form" SelectedDate="{Binding Date, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hours *" Classes="label" Margin="0,0,0,6"/>
                    <NumericUpDown Classes="form filled"
                                   Value="{Binding Hours}"
                                   Minimum="0"
                                   Maximum="24"
                                   Increment="0.5"
                                   FormatString="0.0"/>
                </StackPanel>
            </Grid>

            <!-- Client: pick an existing one or type a new one, same two columns as above -->
            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Client" Classes="label" Margin="0,0,0,6"/>
                    <ComboBox Classes="form" Name="ClientComboBox"
                              ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClientChoice">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Or add a new client" Classes="label" Margin="0,0,0,6"/>
                    <TextBox Classes="form filled"
                             Name="NewClientTextBox"
                             Text="{Binding NewClientName}"
                             Watermark="Client name"/>
                </StackPanel>
            </Grid>

            <!-- Validation Message -->
            <TextBlock Text="{Binding ValidationMessage}" 
                       Classes="error" 
                       IsVisible="{Binding HasValidationError}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Action Buttons - Fixed positioning to avoid overlap -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="12"
                    Margin="0,24,0,0">
            
            <Button Content="Cancel"
                    Classes="dialog secondary"
                    Command="{Binding CancelCommand}"/>
                    
            <Button Content="Save Changes"
                    Classes="dialog primary"
                    Command="{Binding SaveCommand}"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>