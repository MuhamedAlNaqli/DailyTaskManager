<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
             x:Class="DailyTaskManager.Avalonia.Views.DailyTasksView"
             x:DataType="vm:DailyTasksViewModel">

    <Design.DataContext>
        <vm:DailyTasksViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Modern Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Time Tracking" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#FF2E3440"/>
                    <TextBlock Text="Track and manage your daily work hours" 
                               FontSize="14" 
                               Foreground="#FF5E81AC" 
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Action Buttons - Clockify inspired -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           Spacing="12"
                           VerticalAlignment="Center">
                    <Button Classes="primary" 
                            Command="{Binding AddNewTaskCommand}"
                            Background="#FF4C566A"
                            BorderBrush="Transparent"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="16,10"
                            FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="Add Entry"/>
                        </StackPanel>
                    </Button>
                    
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" 
                                Command="{Binding ExportToExcelCommand}"
                                Background="Transparent"
                                BorderBrush="#FFBFDBFE"
                                Foreground="#FF3B82F6"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📊" FontSize="14"/>
                                <TextBlock Text="Excel"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Classes="secondary" 
                                Command="{Binding ExportToPdfCommand}"
                                Background="Transparent"
                                BorderBrush="#FFEF4444"
                                Foreground="#FFEF4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📄" FontSize="14"/>
                                <TextBlock Text="PDF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
            
            <!-- Statistics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Today's Hours -->
                <Border Grid.Column="0" 
                        Background="#FFF8FAFC" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,12,0"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today" FontSize="12" Foreground="#FF64748B" FontWeight="Medium"/>
                        <TextBlock Text="8.5h" FontSize="24" FontWeight="Bold" Foreground="#FF1E293B" Margin="0,4,0,0"/>
                        <TextBlock Text="Target: 8h" FontSize="11" Foreground="#FF10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- This Week -->
                <Border Grid.Column="1" 
                        Background="#FFF8FAFC" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,12,0"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="This Week" FontSize="12" Foreground="#FF64748B" FontWeight="Medium"/>
                        <TextBlock Text="42.5h" FontSize="24" FontWeight="Bold" Foreground="#FF1E293B" Margin="0,4,0,0"/>
                        <TextBlock Text="Target: 40h" FontSize="11" Foreground="#FF10B981" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Entries -->
                <Border Grid.Column="2" 
                        Background="#FFF8FAFC" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,12,0"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Entries" FontSize="12" Foreground="#FF64748B" FontWeight="Medium"/>
                        <TextBlock Text="{Binding FilteredTasks.Count}" FontSize="24" FontWeight="Bold" Foreground="#FF1E293B" Margin="0,4,0,0"/>
                        <TextBlock Text="All time" FontSize="11" Foreground="#FF64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Average Daily -->
                <Border Grid.Column="3" 
                        Background="#FFF8FAFC" 
                        CornerRadius="12" 
                        Padding="20"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Daily Avg" FontSize="12" Foreground="#FF64748B" FontWeight="Medium"/>
                        <TextBlock Text="7.8h" FontSize="24" FontWeight="Bold" Foreground="#FF1E293B" Margin="0,4,0,0"/>
                        <TextBlock Text="Last 30 days" FontSize="11" Foreground="#FF64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Advanced Filters Section -->
            <Border Grid.Row="2" 
                    Background="White" 
                    CornerRadius="12" 
                    Padding="20" 
                    Margin="0,0,0,24"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBlock Text="🔍" FontSize="16"/>
                        <TextBlock Text="Filters" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#FF374151"/>
                    </StackPanel>
                    
                    <!-- Filter Controls -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Search Box -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText}"
                                 Watermark="Search by task description..."
                                 Background="White"
                                 BorderBrush="#FFD1D5DB"
                                 BorderThickness="1"
                                 CornerRadius="8"
                                 Padding="16,6"
                                 FontSize="14"
                                 Height="34"
                                 Margin="0,0,16,0"/>
                        
                        <!-- Date From -->
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="From" FontSize="12" FontWeight="Medium" Foreground="#FF374151"/>
                          <DatePicker Name="DateFromPicker"
                                       SelectedDate="{Binding DateFrom, Mode=OneWay}"
                                       Background="White"
                                       BorderBrush="#FFD1D5DB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="8,4"
                                       FontSize="14"
                                       Height="34"/>
                        </StackPanel>
                        
                        <!-- Date To -->
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="To" FontSize="12" FontWeight="Medium" Foreground="#FF374151"/>
                          <DatePicker Name="DateToPicker"
                                       SelectedDate="{Binding DateTo, Mode=OneWay}"
                                       Background="White"
                                       BorderBrush="#FFD1D5DB"
                                       BorderThickness="1"
                                       CornerRadius="8"
                                       Padding="8,4"
                                       FontSize="14"
                                       Height="34"/>
                        </StackPanel>

                        <!-- Search Button -->
                        <Button Grid.Column="5"
                                Name="SearchButton"
                                Background="#FF3B82F6"
                                BorderBrush="Transparent"
                                Foreground="White"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,6"
                                Margin="16,18,0,0"
                                VerticalAlignment="Bottom"
                                Height="34"
                                ToolTip.Tip="Apply date filters">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔍" FontSize="12"/>
                                <TextBlock Text="Search" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <!-- Clear Filters Button -->
                        <Button Grid.Column="6"
                                Command="{Binding ClearFiltersCommand}"
                                Background="Transparent"
                                BorderBrush="#FFDC2626"
                                Foreground="#FFDC2626"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                Margin="16,18,0,0"
                                VerticalAlignment="Bottom"
                                Height="34"
                                ToolTip.Tip="Clear all filters">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="✖" FontSize="12"/>
                                <TextBlock Text="Clear" FontSize="12"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Grid>
            </Border>

            <!-- Modern Task List -->
            <Border Grid.Row="3" 
                    Background="White" 
                    CornerRadius="12" 
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Border Grid.Row="0" 
                            Background="#FFF8FAFC" 
                            CornerRadius="12,12,0,0"
                            Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="12" Foreground="#FF374151"/>
                            <TextBlock Grid.Column="1" Text="Description" FontWeight="SemiBold" FontSize="12" Foreground="#FF374151"/>
                            <TextBlock Grid.Column="2" Text="Hours" FontWeight="SemiBold" FontSize="12" Foreground="#FF374151" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" FontSize="12" Foreground="#FF374151" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Task List -->
                    <ScrollViewer Grid.Row="1" MaxHeight="500">
                        <ItemsControl ItemsSource="{Binding FilteredTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFF1F5F9" BorderThickness="0,1,0,0" Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Date -->
                                            <TextBlock Grid.Column="0" 
                                                      Text="{Binding Date, StringFormat='{}{0:MMM dd}'}" 
                                                      FontSize="14" 
                                                      Foreground="#FF64748B"
                                                      VerticalAlignment="Center"/>
                                            
                                            <!-- Description -->
                                            <TextBlock Grid.Column="1" 
                                                      Text="{Binding Description}" 
                                                      FontSize="14" 
                                                      Foreground="#FF1F2937"
                                                      TextWrapping="Wrap"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0"/>
                                            
                                            <!-- Hours -->
                                            <Border Grid.Column="2" 
                                                   Background="#FFECFCCB" 
                                                   CornerRadius="6" 
                                                   Padding="8,4"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Hours, StringFormat='{}{0}h'}" 
                                                          FontSize="12" 
                                                          FontWeight="Medium"
                                                          Foreground="#FF365314"/>
                                            </Border>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" 
                                                       Orientation="Horizontal" 
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Spacing="8">
                                                <Button Classes="icon"
                                                       Command="{Binding $parent[ItemsControl].DataContext.EditTaskCommand}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Width="32" Height="32"
                                                       CornerRadius="6"
                                                       ToolTip.Tip="Edit task">
                                                    <TextBlock Text="✏️" FontSize="14"/>
                                                </Button>
                                                <Button Classes="icon"
                                                       Command="{Binding $parent[ItemsControl].DataContext.DeleteTaskCommand}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Width="32" Height="32"
                                                       CornerRadius="6"
                                                       ToolTip.Tip="Delete task">
                                                    <TextBlock Text="🗑️" FontSize="12" Foreground="#FFEF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                               IsVisible="{Binding !FilteredTasks.Count}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Spacing="16"
                               Margin="40">
                        <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="No time entries found" 
                                  FontSize="16" 
                                  FontWeight="Medium"
                                  Foreground="#FF6B7280"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Start tracking your time by adding your first entry" 
                                  FontSize="14" 
                                  Foreground="#FF9CA3AF"
                                  HorizontalAlignment="Center"/>
                        <Button Classes="primary"
                               Command="{Binding AddNewTaskCommand}"
                               Background="#FF4C566A"
                               Foreground="White"
                               CornerRadius="6"
                               Padding="20,12"
                               Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Add Your First Entry"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="4"
                  Background="#80000000"
                  IsVisible="{Binding IsLoading}">
                <Border Background="White"
                        CornerRadius="12"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <ProgressBar IsIndeterminate="True" 
                                    Width="200"
                                    Height="4"
                                    Background="#FFE2E8F0"
                                    Foreground="#FF3B82F6"/>
                        <TextBlock Text="Loading your time entries..." 
                                  HorizontalAlignment="Center" 
                                  FontSize="14"
                                  Foreground="#FF6B7280"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>