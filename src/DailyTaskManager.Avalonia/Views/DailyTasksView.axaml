<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
             x:Class="DailyTaskManager.Avalonia.Views.DailyTasksView"
             x:DataType="vm:DailyTasksViewModel">

    <Design.DataContext>
        <vm:DailyTasksViewModel/>
    </Design.DataContext>

    <ScrollViewer Name="PageScroll">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Modern Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Time Tracking" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialBodyBrush}"/>
                    <TextBlock Text="Track and manage your daily work hours" 
                               FontSize="14" 
                               Foreground="{DynamicResource AppTextMuted}" 
                               Margin="0,4,0,0"/>
                </StackPanel>
                
                <!-- Action Buttons - Clockify inspired -->
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           Spacing="12"
                           VerticalAlignment="Center">
                    <Button Name="QuickAddButton"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AppAccent}"
                            Foreground="{DynamicResource AppAccent}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,10"
                            FontWeight="Medium">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <Border Background="{DynamicResource AppSurface}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        MinWidth="260">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Quick add for today"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppText}"/>
                                        <ItemsControl Name="TemplateList" ItemsSource="{Binding Templates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                        <Button Grid.Column="0"
                                                                Click="OnTemplateClicked"
                                                                Command="{Binding $parent[ItemsControl].DataContext.QuickAddTemplateCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Left"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Padding="10,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource AppTextStrong}"/>
                                                                <TextBlock Text="{Binding Hours, StringFormat='{}{0:0.##}h'}" FontSize="11" Foreground="{DynamicResource AppTextMuted}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding $parent[ItemsControl].DataContext.DeleteTemplateCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                Padding="8,6"
                                                                ToolTip.Tip="Delete template">
                                                            <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource AppDanger}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No templates yet. Tick &quot;Save as a template&quot; when adding an entry."
                                                   IsVisible="{Binding !HasTemplates}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="260"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppTextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="LightningBolt" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Quick add" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="primary" 
                            Command="{Binding AddNewTaskCommand}"
                            Background="{DynamicResource AppAccent}"
                            BorderBrush="Transparent"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="16,10"
                            FontWeight="Medium">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="+" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Entry" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <DropDownButton Classes="secondary"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AppAccent}"
                                    Foreground="{DynamicResource AppAccent}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,10">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" VerticalAlignment="Center"/>
                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Excel"
                                          Command="{Binding ExportToExcelCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="PDF"
                                          Command="{Binding ExportToPdfCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FilePdfBox" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Word"
                                          Command="{Binding ExportToWordCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FileWordOutline" Width="16" Height="16"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </Grid>
            
            <!-- Statistics Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Today's Hours -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AppSurfaceAlt}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,12,0"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Today" FontSize="12" Foreground="{DynamicResource AppTextMuted}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding TodayHours, StringFormat='{}{0:F1}h'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" Margin="0,4,0,0"/>
                        <TextBlock Text="Target: 7h" FontSize="11" Foreground="{DynamicResource AppAccent}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- This Week -->
                <Border Grid.Column="1"
                        Background="{DynamicResource AppSurfaceAlt}"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,12,0"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="This Week" FontSize="12" Foreground="{DynamicResource AppTextMuted}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding ThisWeekHours, StringFormat='{}{0:F1}h'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" Margin="0,4,0,0"/>
                        <TextBlock Text="Target: 35h" FontSize="11" Foreground="{DynamicResource AppAccent}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Entries -->
                <Border Grid.Column="2" 
                        Background="{DynamicResource AppSurfaceAlt}" 
                        CornerRadius="12" 
                        Padding="20" 
                        Margin="0,0,12,0"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Entries" FontSize="12" Foreground="{DynamicResource AppTextMuted}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" Margin="0,4,0,0"/>
                        <TextBlock Text="Matching filters" FontSize="11" Foreground="{DynamicResource AppTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Average Daily -->
                <Border Grid.Column="3"
                        Background="{DynamicResource AppSurfaceAlt}"
                        CornerRadius="12"
                        Padding="20"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Daily Avg" FontSize="12" Foreground="{DynamicResource AppTextMuted}" FontWeight="Medium"/>
                        <TextBlock Text="{Binding DailyAverage30Days, StringFormat='{}{0:F1}h'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}" Margin="0,4,0,0"/>
                        <TextBlock Text="Last 30 days" FontSize="11" Foreground="{DynamicResource AppTextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Advanced Filters Section -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource AppSurface}" 
                    CornerRadius="12" 
                    Padding="20" 
                    Margin="0,0,0,24"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Filter Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18"/>
                        <TextBlock Text="Filters" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource AppText}"/>
                    </StackPanel>
                    
                    <!-- Filter Controls -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <TextBox Classes="filled" Grid.Column="0" Name="SearchBox"
                                 Text="{Binding SearchText}"
                                 Watermark="Search by task description (min 3 characters)..."
                                 Padding="16,6"
                                 FontSize="14"
                                 Height="34"
                                 Margin="0,0,16,0"/>

                        <!-- Date Range Picker Button -->
                        <!-- Client filter -->
                        <ComboBox Classes="filled" Grid.Column="1"
                                  Name="ClientFilterComboBox"
                                  ItemsSource="{Binding ClientFilterOptions}"
                                  SelectedItem="{Binding SelectedClientFilter}"
                                  MinWidth="170"
                                  Height="34"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ClientChoice">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Name="DateRangeButton"
                                Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                Height="34"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border Background="{DynamicResource AppSurface}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Select Date Range"
                                                      FontSize="14"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource AppText}"/>
                                            <TextBlock Text="Click start date, then click end date"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource AppTextMuted}"
                                                      TextWrapping="Wrap"
                                                      MaxWidth="280"/>
                                            <Calendar Name="DateRangeCalendar"
                                                     SelectionMode="SingleRange"
                                                     AllowTapRangeSelection="True"
                                                     Background="{DynamicResource AppInputBg}"/>
                                            <StackPanel Orientation="Horizontal"
                                                       HorizontalAlignment="Right"
                                                       Spacing="8">
                                                <Button Content="Clear All Filters"
                                                       Name="ClearAllFiltersButton"
                                                       Background="Transparent"
                                                       BorderBrush="{DynamicResource AppDanger}"
                                                       Foreground="{DynamicResource AppDanger}"
                                                       BorderThickness="1"
                                                       CornerRadius="6"
                                                       Padding="12,6"/>
                                                <Button Content="Apply"
                                                       Name="ApplyDateRangeButton"
                                                       Background="{DynamicResource AppAccent}"
                                                       BorderBrush="Transparent"
                                                       Foreground="White"
                                                       BorderThickness="1"
                                                       CornerRadius="6"
                                                       Padding="12,6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="CalendarRange" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Name="DateRangeText"
                                          Text="Select Date Range"
                                          FontSize="12"
                                          Foreground="{DynamicResource AppText}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Assign a client to every entry matching the filters -->
                        <Button Grid.Column="3"
                                Name="AssignClientButton"
                                Margin="12,0,0,0"
                                Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppBorderStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                Height="34"
                                VerticalAlignment="Center">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Background="{DynamicResource AppSurface}"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="12" Width="300">
                                            <TextBlock Text="Assign client"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AppText}"/>
                                            <TextBlock Text="Applies to every entry matching the current search, date range and client filter (all pages)."
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource AppTextMuted}"/>
                                            <ComboBox Classes="filled" Name="AssignClientComboBox"
                                                      HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding AssignOptions}"
                                                      SelectedItem="{Binding AssignTarget}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ClientChoice">
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Content="Assign to matching entries"
                                                    Name="AssignClientApplyButton"
                                                    Command="{Binding AssignClientToFilteredCommand}"
                                                    HorizontalAlignment="Right"
                                                    Background="{DynamicResource AppAccent}"
                                                    BorderBrush="Transparent"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Padding="12,6"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="AccountMultiple" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Assign client"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>
                </Grid>
            </Border>

            <!-- Modern Task List -->
            <Border Grid.Row="3" 
                    Background="{DynamicResource AppSurface}" 
                    CornerRadius="12" 
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Header -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource AppSurfaceAlt}" 
                            CornerRadius="12,12,0,0"
                            Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}"/>
                            <TextBlock Grid.Column="1" Text="Description" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}"/>
                            <TextBlock Grid.Column="2" Text="Hours" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource AppText}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Task List -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,1,0,0" Padding="20,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="140"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Date -->
                                            <TextBlock Grid.Column="0" 
                                                      Text="{Binding Date, StringFormat='{}{0:MMM dd}'}" 
                                                      FontSize="14" 
                                                      Foreground="{DynamicResource AppTextMuted}"
                                                      VerticalAlignment="Center"/>
                                            
                                            <!-- Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="6">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource AppTextStrong}"
                                                           TextWrapping="Wrap"
                                                           Background="Transparent"
                                                           DoubleTapped="OnDescriptionDoubleTapped"
                                                           ToolTip.Tip="Double-click to edit"/>
                                                <Border IsVisible="{Binding Client, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                        Background="{DynamicResource AppBadgeBg}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Client.Name}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource AppBadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Hours -->
                                            <Border Grid.Column="2" 
                                                   Background="{DynamicResource AppBadgeBg}" 
                                                   CornerRadius="6" 
                                                   Padding="8,4"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                                <TextBlock DoubleTapped="OnHoursDoubleTapped" ToolTip.Tip="Double-click to edit"
                                                          Text="{Binding Hours, StringFormat='{}{0:0.##}h'}" FontSize="12" 
                                                          FontWeight="Medium"
                                                          Foreground="{DynamicResource AppBadgeText}"/>
                                            </Border>
                                            
                                            <!-- Actions -->
                                            <StackPanel Grid.Column="3" 
                                                       Orientation="Horizontal" 
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Spacing="8">
                                                <Button Classes="icon"
                                                       Command="{Binding $parent[ItemsControl].DataContext.DuplicateTaskCommand}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Width="32" Height="32"
                                                       CornerRadius="6"
                                                       ToolTip.Tip="Duplicate to today">
                                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16"/>
                                                </Button>
                                                <Button Classes="icon"
                                                       Command="{Binding $parent[ItemsControl].DataContext.EditTaskCommand}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Width="32" Height="32"
                                                       CornerRadius="6"
                                                       ToolTip.Tip="Edit task">
                                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16"/>
                                                </Button>
                                                <Button Classes="icon"
                                                       Command="{Binding $parent[ItemsControl].DataContext.DeleteTaskCommand}"
                                                       CommandParameter="{Binding}"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       Width="32" Height="32"
                                                       CornerRadius="6"
                                                       ToolTip.Tip="Delete task">
                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="14" Height="14" Foreground="{DynamicResource AppDanger}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Pager -->
                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource AppDivider}"
                            BorderThickness="0,1,0,0"
                            Padding="20,12"
                            IsVisible="{Binding TotalCount}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Name="PageInfoText"
                                       Text="{Binding PageInfo}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextMuted}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Name="FirstPageButton" Content="«" Command="{Binding FirstPageCommand}" ToolTip.Tip="First page" Padding="10,4"/>
                                <Button Name="PreviousPageButton" Content="‹ Previous" Command="{Binding PreviousPageCommand}" Padding="10,4"/>
                                <Button Name="NextPageButton" Content="Next ›" Command="{Binding NextPageCommand}" Padding="10,4"/>
                                <Button Name="LastPageButton" Content="»" Command="{Binding LastPageCommand}" ToolTip.Tip="Last page" Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                               IsVisible="{Binding !TotalCount}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Spacing="16"
                               Margin="40">
                        <materialIcons:MaterialIcon Kind="NotebookEditOutline" Width="50" Height="50" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="No time entries found" 
                                  FontSize="16" 
                                  FontWeight="Medium"
                                  Foreground="{DynamicResource AppTextMuted}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Start tracking your time by adding your first entry" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource AppTextFaint}"
                                  HorizontalAlignment="Center"/>
                        <Button Classes="primary"
                               Command="{Binding AddNewTaskCommand}"
                               Background="{DynamicResource AppAccent}"
                               Foreground="White"
                               CornerRadius="6"
                               Padding="20,12"
                               Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="+" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Text="Add Your First Entry" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toast -->
            <Border Grid.RowSpan="4"
                    Name="ToastBar"
                    IsVisible="{Binding IsToastVisible}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,80"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="#FF166534"
                    BoxShadow="0 4 16 0 #40000000">
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" FontSize="13"/>
            </Border>

            <!-- Undo bar -->
            <Border Grid.RowSpan="4"
                    Name="UndoBar"
                    IsVisible="{Binding IsUndoVisible}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,24"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="#FF334155"
                    BoxShadow="0 4 16 0 #40000000">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding UndoMessage}"
                               Foreground="White"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Name="UndoDeleteButton"
                            Content="Undo"
                            Command="{Binding UndoDeleteCommand}"
                            Background="{DynamicResource AppAccent}"
                            BorderBrush="Transparent"
                            Foreground="White"
                            CornerRadius="6"
                            Padding="12,4"/>
                </StackPanel>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="4"
                  Background="#80000000"
                  IsVisible="{Binding IsLoading}">
                <Border Background="{DynamicResource AppSurface}"
                        CornerRadius="12"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <ProgressBar IsIndeterminate="True" 
                                    Width="200"
                                    Height="4"
                                    Background="{DynamicResource AppBorder}"
                                    Foreground="{DynamicResource AppAccent}"/>
                        <TextBlock Text="Loading your time entries..." 
                                  HorizontalAlignment="Center" 
                                  FontSize="14"
                                  Foreground="{DynamicResource AppTextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>