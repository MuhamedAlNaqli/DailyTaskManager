<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        x:Class="DailyTaskManager.Avalonia.Views.AddTaskDialog"
        x:DataType="vm:AddTaskViewModel"
        Title="Add New Task"
        Width="450"
        MinWidth="400" 
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Design.DataContext>
        <vm:AddTaskViewModel/>
    </Design.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Add New Daily Task"
                   Classes="title"
                   Margin="0,0,0,20"/>

        <!-- Form Content -->
        <StackPanel Grid.Row="1" Spacing="15">
            
            <!-- Task Description -->
            <StackPanel>
                <TextBlock Text="Description *" 
                           Classes="label" 
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding Description}" 
                         Watermark="Enter task description (supports multiple lines)"
                         Classes="primary"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="60"
                         MaxHeight="120"/>
            </StackPanel>

            <!-- Date and Hours -->
            <Grid ColumnDefinitions="*,10,120">
                
                <!-- Date -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Date *" 
                               Classes="label" 
                               Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding Date}" 
                                Classes="primary"/>
                </StackPanel>

                <!-- Hours -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hours *" 
                               Classes="label" 
                               Margin="0,0,0,5"/>
                    <NumericUpDown Value="{Binding Hours}" 
                                   Minimum="0" 
                                   Maximum="24" 
                                   Increment="0.5" 
                                   FormatString="0.0"
                                   Classes="primary"/>
                </StackPanel>
            </Grid>

            <!-- Validation Message -->
            <TextBlock Text="{Binding ValidationMessage}" 
                       Classes="error" 
                       IsVisible="{Binding HasValidationError}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10"
                    Margin="0,20,0,0">
            
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}"
                    Background="White"
                    BorderBrush="#FFD1D5DB"
                    BorderThickness="1"
                    Foreground="#FF374151"
                    CornerRadius="6"
                    Padding="16,8"
                    MinWidth="80"/>
                    
            <Button Content="Add Task" 
                    Command="{Binding SaveCommand}"
                    IsDefault="True"
                    Background="#FF4C566A"
                    BorderBrush="Transparent"
                    Foreground="White"
                    CornerRadius="6"
                    Padding="16,8"
                    FontWeight="Medium"
                    MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>