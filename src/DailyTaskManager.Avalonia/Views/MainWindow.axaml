<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        xmlns:views="using:DailyTaskManager.Avalonia.Views"
        x:Class="DailyTaskManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Daily Task Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource AppSidebar}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="20,24,20,24">
                    <Border Background="{DynamicResource AppAccent}"
                            CornerRadius="11"
                            Width="38" Height="38">
                        <materialIcons:MaterialIcon Kind="ClockCheckOutline"
                                                    Width="22" Height="22"
                                                    Foreground="{DynamicResource AppOnAccent}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Daily Tasks"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextStrong}"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextFaint}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0" Spacing="4">
                    <Button AutomationProperties.AutomationId="NavDailyTasks"
                            AutomationProperties.Name="Daily Tasks"
                            Classes="sidebar-nav"
                            Classes.active="{Binding IsTasksViewSelected}"
                            Command="{Binding NavigateToTasksCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ClipboardCheckOutline" Width="20" Height="20"/>
                            <TextBlock Text="Daily Tasks" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.AutomationId="NavCalendar"
                            AutomationProperties.Name="Calendar"
                            Classes="sidebar-nav"
                            Classes.active="{Binding IsCalendarViewSelected}"
                            Command="{Binding NavigateToCalendarCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="CalendarMonthOutline" Width="20" Height="20"/>
                            <TextBlock Text="Calendar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.AutomationId="NavAnalytics"
                            AutomationProperties.Name="Analytics"
                            Classes="sidebar-nav"
                            Classes.active="{Binding IsAnalyticsViewSelected}"
                            Command="{Binding NavigateToAnalyticsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ChartBoxOutline" Width="20" Height="20"/>
                            <TextBlock Text="Analytics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.AutomationId="NavReports"
                            AutomationProperties.Name="Reports"
                            Classes="sidebar-nav"
                            Classes.active="{Binding IsReportsViewSelected}"
                            Command="{Binding NavigateToReportsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="20" Height="20"/>
                            <TextBlock Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,24" Spacing="2">
                    <Border Height="1" Background="{DynamicResource AppDivider}" Margin="8,0,8,10"/>

                    <Button AutomationProperties.AutomationId="NavSettings"
                            AutomationProperties.Name="Settings"
                            Classes="sidebar-nav quiet"
                            Classes.active="{Binding IsSettingsViewSelected}"
                            Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.AutomationId="ThemeToggleButton"
                            AutomationProperties.Name="Theme"
                            Classes="sidebar-nav quiet"
                            Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18"/>
                            <TextBlock Text="{Binding ThemeText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button AutomationProperties.AutomationId="LogoutButton"
                            AutomationProperties.Name="Logout"
                            Classes="sidebar-nav quiet"
                            Margin="0,6,0,0"
                            Command="{Binding LogoutCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <materialIcons:MaterialIcon Kind="Logout" Width="18" Height="18" Foreground="{DynamicResource AppDanger}"/>
                            <TextBlock Text="Logout" VerticalAlignment="Center" Foreground="{DynamicResource AppDanger}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1" Margin="10,6,10,10">
            <!-- Missing-day reminder -->
            <Border DockPanel.Dock="Top"
                    Name="ReminderBanner"
                    IsVisible="{Binding IsReminderVisible}"
                    Background="{DynamicResource AppWarningSoft}"
                    BorderBrush="{DynamicResource AppWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,10"
                    Margin="14,8,14,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <materialIcons:MaterialIcon Grid.Column="0"
                                                Kind="BellRingOutline"
                                                Width="20" Height="20"
                                                Foreground="#FFD97706"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                               Name="ReminderText"
                               Text="{Binding ReminderText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextStrong}"/>
                    <Button Grid.Column="2"
                            Name="ReminderAddButton"
                            Classes="primary"
                            Content="{Binding ReminderActionText}"
                            Command="{Binding AddMissingEntryCommand}"
                            Margin="12,0,8,0"
                            MinHeight="34"
                            Padding="14,6"/>
                    <Button Grid.Column="3"
                            Name="ReminderDismissButton"
                            Content="Dismiss"
                            Command="{Binding DismissReminderCommand}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource AppTextMuted}"
                            Padding="10,6"/>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentView}"
                            Classes="fade-in"/>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2"
              Classes="loading-overlay"
              IsVisible="{Binding IsLoading}">
            <Border Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="40,32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <ProgressBar IsIndeterminate="True"
                                 Width="200"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Foreground="{DynamicResource AppText}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
