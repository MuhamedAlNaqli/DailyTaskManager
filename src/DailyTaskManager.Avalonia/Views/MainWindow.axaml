<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        xmlns:views="using:DailyTaskManager.Avalonia.Views"
        x:Class="DailyTaskManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Daily Task Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource AppSidebar}" BorderBrush="{DynamicResource AppBorder}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- App Header -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource AppSidebar}"
                        Padding="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF8B5FBF"
                                CornerRadius="6"
                                Padding="6,4"
                                Margin="0,0,12,0">
                            <TextBlock Text="📊" FontSize="16" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DTM"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextStrong}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,20">

                    <!-- Daily Tasks -->
                    <Button AutomationProperties.AutomationId="NavDailyTasks"
                            AutomationProperties.Name="Daily Tasks"
                            Classes="sidebar-nav"
                            Command="{Binding NavigateToTasksCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Daily Tasks"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Calendar -->
                    <Button AutomationProperties.AutomationId="NavCalendar"
                            AutomationProperties.Name="Calendar"
                            Classes="sidebar-nav"
                            Command="{Binding NavigateToCalendarCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="🗓️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Calendar"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Analytics -->
                    <Button AutomationProperties.AutomationId="NavAnalytics"
                            AutomationProperties.Name="Analytics"
                            Classes="sidebar-nav"
                            Command="{Binding NavigateToAnalyticsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Analytics"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Reports -->
                    <Button AutomationProperties.AutomationId="NavReports"
                            AutomationProperties.Name="Reports"
                            Classes="sidebar-nav"
                            Command="{Binding NavigateToReportsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Reports"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource AppText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Spacer to push bottom elements down -->
                <Border DockPanel.Dock="Top" />

                <!-- Bottom Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20" Spacing="4">

                    <!-- Settings -->
                    <Button Classes="sidebar-nav"
                            Command="{Binding NavigateToSettingsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextMuted}"/>
                        </Grid>
                    </Button>

                    <!-- Help -->
                    <Button Classes="sidebar-nav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="❓" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Help"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextMuted}"/>
                        </Grid>
                    </Button>

                    <!-- Theme toggle -->
                    <Button Classes="sidebar-nav"
                            AutomationProperties.AutomationId="ThemeToggleButton"
                            AutomationProperties.Name="Theme"
                            Command="{Binding ToggleThemeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🌓" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ThemeText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextMuted}"/>
                        </Grid>
                    </Button>

                    <!-- Logout Button -->
                    <Button AutomationProperties.AutomationId="LogoutButton"
                            AutomationProperties.Name="Logout"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚪" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Logout"
                                       FontSize="13"
                                       Foreground="#FFEF4444"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <DockPanel Grid.Column="1" Margin="10">
            <!-- Missing-day reminder -->
            <Border DockPanel.Dock="Top"
                    Name="ReminderBanner"
                    IsVisible="{Binding IsReminderVisible}"
                    Background="#33F59E0B"
                    BorderBrush="#66F59E0B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="14,4,14,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="⏰" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Name="ReminderText"
                               Text="{Binding ReminderText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextStrong}"/>
                    <Button Grid.Column="2"
                            Name="ReminderAddButton"
                            Content="{Binding ReminderActionText}"
                            Command="{Binding AddMissingEntryCommand}"
                            Margin="12,0,8,0"
                            Background="#FF4C566A"
                            Foreground="White"
                            BorderBrush="Transparent"
                            CornerRadius="6"
                            Padding="12,6"/>
                    <Button Grid.Column="3"
                            Name="ReminderDismissButton"
                            Content="Dismiss"
                            Command="{Binding DismissReminderCommand}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{DynamicResource AppTextMuted}"
                            Padding="10,6"/>
                </Grid>
            </Border>

            <ContentControl Content="{Binding CurrentView}"
                            Classes="fade-in"/>
        </DockPanel>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2"
              Classes="loading-overlay"
              IsVisible="{Binding IsLoading}">
            <Border Background="{DynamicResource MaterialPaperBrush}"
                    CornerRadius="12"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <!-- Replace with Avalonia ProgressBar -->
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>