<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        xmlns:views="using:DailyTaskManager.Avalonia.Views"
        x:Class="DailyTaskManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Daily Task Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">

                <!-- App Header -->
                <Border DockPanel.Dock="Top"
                        Background="White"
                        Padding="20,24,20,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF8B5FBF"
                                CornerRadius="6"
                                Padding="6,4"
                                Margin="0,0,12,0">
                            <TextBlock Text="📊" FontSize="16" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DTM"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#FF1F2937"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top" Margin="16,0,16,20">

                    <!-- Daily Tasks -->
                    <Button Classes="sidebar-nav"
                            Command="{Binding NavigateToTasksCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📅" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Daily Tasks"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#FF374151"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Analytics -->
                    <Button Classes="sidebar-nav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📊" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Analytics"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#FF9CA3AF"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Reports -->
                    <Button Classes="sidebar-nav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Reports"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#FF9CA3AF"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Speech to Text -->
                    <Button Classes="sidebar-nav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,10"
                            Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="20" Height="20"
                                    Margin="0,0,12,0">
                                <TextBlock Text="🎤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="Speech to Text"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#FF9CA3AF"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                </StackPanel>

                <!-- Spacer to push bottom elements down -->
                <Border DockPanel.Dock="Top" />

                <!-- Bottom Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20" Spacing="4">

                    <!-- Settings -->
                    <Button Classes="sidebar-nav"
                            Command="{Binding NavigateToSettingsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       FontSize="13"
                                       Foreground="#FF6B7280"/>
                        </Grid>
                    </Button>

                    <!-- Help -->
                    <Button Classes="sidebar-nav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="❓" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Help"
                                       FontSize="13"
                                       Foreground="#FF6B7280"/>
                        </Grid>
                    </Button>

                    <!-- Logout Button -->
                    <Button Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚪" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="Logout"
                                       FontSize="13"
                                       Foreground="#FFEF4444"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Classes="fade-in"
                        Margin="10"/>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2"
              Classes="loading-overlay"
              IsVisible="{Binding IsLoading}">
            <Border Background="{DynamicResource MaterialPaperBrush}"
                    CornerRadius="12"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <!-- Replace with Avalonia ProgressBar -->
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>