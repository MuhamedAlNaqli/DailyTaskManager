<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        xmlns:views="using:DailyTaskManager.Avalonia.Views"
        x:Class="DailyTaskManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Daily Task Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Classes="card">
            <DockPanel LastChildFill="True">
                
                <!-- App Header -->
                <Border DockPanel.Dock="Top" 
                        Background="{DynamicResource MaterialPaperBrush}"
                        Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <!-- TODO: Add MaterialIcon when package is working -->
                            <TextBlock Text="📅" FontSize="24" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Daily Task Manager"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="11"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- User Info -->
                        <Border Background="{DynamicResource MaterialPrimaryMidBrush}"
                                CornerRadius="8"
                                Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding UserDisplayName}"
                                           FontWeight="Medium"
                                           FontSize="14"/>
                                <TextBlock Text="{Binding UserEmail}"
                                           FontSize="12"
                                           Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <StackPanel DockPanel.Dock="Top" Margin="10">
                    
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsTasksViewSelected}"
                                  Command="{Binding NavigateToTasksCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Daily Tasks" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsSettingsViewSelected}"
                                  Command="{Binding NavigateToSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Settings" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsSpeechViewSelected}"
                                  Command="{Binding NavigateToSpeechCommand}"
                                  IsVisible="{Binding SpeechRecognitionAvailable}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎤" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Speech Input" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Test Google OAuth Button -->
                    <Button Classes="nav"
                            Command="{Binding TestGoogleLoginCommand}"
                            Background="#FF10B981"
                            Foreground="White"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔐" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Test Google Login" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Actions -->
                <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,20">
                    
                    <!-- Theme Toggle -->
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsDarkTheme}"
                                  Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌙" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding ThemeText}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Logout Button -->
                    <Button Classes="danger"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🚪" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Logout" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Classes="fade-in"
                        Margin="10"/>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2"
              Classes="loading-overlay"
              IsVisible="{Binding IsLoading}">
            <Border Background="{DynamicResource MaterialPaperBrush}"
                    CornerRadius="12"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <!-- Replace with Avalonia ProgressBar -->
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>