<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
        xmlns:views="using:DailyTaskManager.Avalonia.Views"
        x:Class="DailyTaskManager.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Daily Task Manager"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Classes="card">
            <DockPanel LastChildFill="False">
                
                <!-- App Header -->
                <Border DockPanel.Dock="Top" 
                        Background="{DynamicResource MaterialPaperBrush}"
                        Padding="20,20,20,16">
                    <StackPanel Orientation="Horizontal">
                        <!-- TODO: Add MaterialIcon when package is working -->
                        <TextBlock Text="📅" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="DTM"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AppVersion}"
                                       FontSize="11"
                                       Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User Welcome Info - Under app header, made wider -->
                <Border DockPanel.Dock="Top" 
                        Background="{DynamicResource MaterialPrimaryMidBrush}"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="12,8,12,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding UserDisplayName}"
                                   FontWeight="Medium"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding UserEmail}"
                                   FontSize="11"
                                   Opacity="0.8"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </Grid>
                </Border>

                <!-- Navigation Menu - Only Daily Tasks -->
                <StackPanel DockPanel.Dock="Top" Margin="16,10">
                    
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsTasksViewSelected}"
                                  Command="{Binding NavigateToTasksCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📅" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Daily Tasks" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </ToggleButton>

                </StackPanel>

                <!-- Spacer to push bottom elements down -->
                <Border DockPanel.Dock="Top" />

                <!-- Bottom Actions - Theme, Settings, Logout -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,20">
                    
                    <!-- Theme Toggle -->
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsDarkTheme}"
                                  Command="{Binding ToggleThemeCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🌙" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ThemeText}" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </ToggleButton>

                    <!-- Settings Button - Moved to bottom area -->
                    <ToggleButton Classes="nav"
                                  IsChecked="{Binding IsSettingsViewSelected}"
                                  Command="{Binding NavigateToSettingsCommand}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </ToggleButton>

                    <!-- Logout Button - At the very bottom -->
                    <Button Classes="danger"
                            Command="{Binding LogoutCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚪" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Logout" 
                                       VerticalAlignment="Center" 
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Classes="fade-in"
                        Margin="10"/>

        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2"
              Classes="loading-overlay"
              IsVisible="{Binding IsLoading}">
            <Border Background="{DynamicResource MaterialPaperBrush}"
                    CornerRadius="12"
                    Padding="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="15">
                    <!-- Replace with Avalonia ProgressBar -->
                    <ProgressBar IsIndeterminate="True" 
                                 Width="200"/>
                    <TextBlock Text="{Binding LoadingMessage}"
                               HorizontalAlignment="Center"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>