<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
             x:Class="DailyTaskManager.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Modern Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource AppTextStrong}"/>
                    <TextBlock Text="Configure application preferences and PDF export settings" 
                               FontSize="14" 
                               Foreground="{DynamicResource AppTextMuted}" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            
            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24">
                    
                    <!-- Interface language -->
                    <Border Background="{DynamicResource AppSurface}"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="Translate" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Language"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource AppTextStrong}"/></StackPanel>
                                <TextBlock Text="Choose the language of the application. The change applies immediately."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                                <TextBlock Text="Interface language" Classes="label"/>
                                <ComboBox Name="AppLanguageComboBox"
                                          Classes="form"
                                          ItemsSource="{Binding AppLanguages}"
                                          SelectedItem="{Binding SelectedAppLanguage}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:Object">
                                            <TextBlock Text="{Binding Value}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PDF Export Settings -->
                    <Border Background="{DynamicResource AppSurface}" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Margin="0,0,10,0"/>
                                    <TextBlock Text="PDF Export Customization" 
                                               FontWeight="SemiBold" 
                                               FontSize="18"
                                               Foreground="{DynamicResource AppText}"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Command="{Binding SavePdfSettingsCommand}" 
                                        Classes="primary"
                                        Background="{DynamicResource AppAccentFill}"
                                        BorderBrush="Transparent"
                                        Foreground="White"
                                        CornerRadius="6"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                                        <TextBlock Text="Save PDF Settings"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - Header Settings -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Header Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Foreground="{DynamicResource AppText}"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.CompanyName}"
                                             Watermark="Company Name"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.CompanyId}"
                                             Watermark="Company ID"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.AddressLine1}"
                                             Watermark="Address Line 1"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.AddressLine2}"
                                             Watermark="Address Line 2"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.Phone}"
                                             Watermark="Phone"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.Email}"
                                             Watermark="Email"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Right Column - Client & Document Settings -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Client and Document Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Foreground="{DynamicResource AppText}"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ClientName}"
                                             Watermark="Client Name"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ClientId}"
                                             Watermark="Client ID"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.DocumentTitle}"
                                             Watermark="Document Title"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ContractPrefix}"
                                             Watermark="Contract Number Prefix"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Classes="filled" Text="{Binding PdfSettings.DecisionNumber}"
                                             Watermark="Decision Number"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>

                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ClientVatNumber}"
                                             Watermark="Client VAT Number"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>

                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ClientAddressLine1}"
                                             Watermark="Client Address Line 1"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>

                                    <TextBox Classes="filled" Text="{Binding PdfSettings.ClientAddressLine2}"
                                             Watermark="Client Address Line 2"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>

                                    <CheckBox Content="Show Company Logo Border"
                                              IsChecked="{Binding PdfSettings.ShowLogoBorder}"
                                              Margin="0,0,0,12"/>
                                    
                                    <CheckBox Content="Include Signature Section"
                                              IsChecked="{Binding PdfSettings.IncludeSignatures}"
                                              Margin="0,0,0,12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Preview Button -->
                            <Button Command="{Binding PreviewPdfCommand}" 
                                    Classes="secondary"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AppAccentSoftBorder}"
                                    Foreground="{DynamicResource AppAccent}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,10"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                    <TextBlock Text="Preview PDF"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Application Settings Section -->
                    <Border Background="{DynamicResource AppSurface}" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="TuneVariant" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Application Settings (Read-only)" 
                                       FontWeight="SemiBold" 
                                       FontSize="18"
                                       Foreground="{DynamicResource AppText}"
                                       Margin="0,0,0,16"/></StackPanel>
                            
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,2*" Margin="12,8">
                                        <TextBlock Grid.Column="0" Text="Key" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                                        <TextBlock Grid.Column="1" Text="Value" FontWeight="SemiBold" Foreground="{DynamicResource AppText}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AppSettings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource AppSurface}"
                                                        BorderBrush="{DynamicResource AppBorder}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="12,8">
                                                    <Grid ColumnDefinitions="*,2*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Key}" TextWrapping="Wrap" Foreground="{DynamicResource AppText}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" Foreground="{DynamicResource AppText}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Database Settings Section -->
                    <Border Background="{DynamicResource AppSurface}" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="FolderArrowDownOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Export Settings"
                                       FontWeight="SemiBold"
                                       FontSize="18"
                                       Foreground="{DynamicResource AppText}"
                                       Margin="0,0,0,16"/></StackPanel>

                            <!-- PDF Export Path -->
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="FilePdfBox" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="PDF Export Location"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource AppText}"/></StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Classes="filled" Grid.Column="0"
                                                 Text="{Binding PdfExportPath}"
                                                 Watermark="Select folder path for PDF exports"
                                                 Padding="12,8"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                                Command="{Binding BrowsePdfFolderCommand}"
                                                Classes="secondary"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AppAccentSoftBorder}"
                                                Foreground="{DynamicResource AppAccent}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                <TextBlock Text="Browse"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="PDF documents will be exported to this location"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Word Export Path -->
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="FileWordOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Word Export Location"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource AppText}"/></StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Classes="filled" Grid.Column="0"
                                                 Text="{Binding WordExportPath}"
                                                 Watermark="Select folder path for Word exports"
                                                 Padding="12,8"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                                Command="{Binding BrowseWordFolderCommand}"
                                                Classes="secondary"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AppAccentSoftBorder}"
                                                Foreground="{DynamicResource AppAccent}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                <TextBlock Text="Browse"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Word documents will be exported to this location"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Excel Export Path -->
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="FileExcelOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Excel Export Location"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,8"
                                               Foreground="{DynamicResource AppText}"/></StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Classes="filled" Grid.Column="0"
                                                 Text="{Binding ExcelExportPath}"
                                                 Watermark="Select folder path for Excel exports"
                                                 Padding="12,8"
                                                 FontSize="12"
                                                 IsReadOnly="True"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                                Command="{Binding BrowseExcelFolderCommand}"
                                                Classes="secondary"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource AppAccentSoftBorder}"
                                                Foreground="{DynamicResource AppAccent}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14"/>
                                                <TextBlock Text="Browse"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Excel files will be exported to this location"
                                               FontSize="11"
                                               Foreground="{DynamicResource AppTextMuted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <!-- Data Section -->
                    <Border Background="{DynamicResource AppSurface}"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Backup and import"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextStrong}"/></StackPanel>
                                <TextBlock Text="Save your entries and templates to a file, restore them, or bring entries in from a spreadsheet"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Name="BackupButton"
                                        Content="Back up my data"
                                        Command="{Binding BackupDataCommand}"
                                        Background="{DynamicResource AppAccentFill}" Foreground="White" BorderBrush="Transparent"
                                        CornerRadius="6" Padding="16,10"/>
                                <Button Name="RestoreButton"
                                        Content="Restore from backup"
                                        Command="{Binding RestoreBackupCommand}"
                                        Background="Transparent" Foreground="{DynamicResource AppAccent}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1"
                                        CornerRadius="6" Padding="16,10"/>
                                <Button Name="ImportButton"
                                        Content="Import CSV / Excel"
                                        Command="{Binding ImportEntriesCommand}"
                                        Background="Transparent" Foreground="{DynamicResource AppAccent}" BorderBrush="{DynamicResource AppAccent}" BorderThickness="1"
                                        CornerRadius="6" Padding="16,10"/>
                            </StackPanel>
                            <TextBlock Text="Restoring or importing never deletes anything: entries that already exist (same date, description and hours) are skipped. CSV and Excel files need Date, Description and Hours columns (the app's own exports work)."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextFaint}"/>
                        </StackPanel>
                    </Border>

                    <!-- Reminder Section -->
                    <Border Background="{DynamicResource AppSurface}"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Reminders"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextStrong}"/></StackPanel>
                                <TextBlock Text="Show a banner when a working day (Mon-Fri) has no entry"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <CheckBox Name="ReminderEnabledCheckBox"
                                      Content="Remind me about working days without an entry"
                                      IsChecked="{Binding ReminderEnabled}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding ReminderEnabled}">
                                <TextBlock Text="Remind me about today from (hour, 0-23)"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppText}"/>
                                <NumericUpDown Name="ReminderHourInput"
                                               Value="{Binding ReminderHour}"
                                               Minimum="0" Maximum="23" Increment="1"
                                               FormatString="0"
                                               Width="120"
                                               Classes="primary filled"/>
                            </StackPanel>
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding IsBackgroundReminderSupported}">
                                <CheckBox Name="BackgroundReminderCheckBox"
                                          Content="Also remind me with a Windows notification when the app is closed"
                                          IsEnabled="{Binding ReminderEnabled}"
                                          IsChecked="{Binding BackgroundReminderEnabled}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Name="TestReminderButton"
                                            Content="Show a test notification"
                                            Command="{Binding SendTestReminderCommand}"
                                            Classes="secondary"/>
                                    <TextBlock Name="BackgroundReminderStatusText"
                                               Text="{Binding BackgroundReminderStatus}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppTextMuted}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Dictation Section -->
                    <Border Background="{DynamicResource AppSurface}"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="MicrophoneOutline" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Dictation"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource AppTextStrong}"/></StackPanel>
                                <TextBlock Text="Speech is turned into text on this computer with the Whisper model; nothing is sent anywhere. The model (about 190 MB) is downloaded the first time you press Dictate."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <StackPanel Spacing="6" MaxWidth="360" HorizontalAlignment="Left">
                                <TextBlock Text="Language you speak" Classes="label"/>
                                <ComboBox Name="DictationLanguageComboBox"
                                          Classes="form"
                                          ItemsSource="{Binding DictationLanguages}"
                                          SelectedItem="{Binding SelectedDictationLanguage}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:Object">
                                            <TextBlock Text="{Binding Value}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="Choosing the language is more accurate than detecting it, especially for short phrases."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Updates Section -->
                    <Border Background="{DynamicResource AppSurface}"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            Margin="0,0,0,24">
                        <StackPanel Spacing="20">
                            <!-- Section Header -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10"><materialIcons:MaterialIcon Kind="Update" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/><TextBlock Text="Updates"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="{DynamicResource AppTextStrong}"/></StackPanel>
                                <TextBlock Text="Check for and manage application updates"
                                          FontSize="13"
                                          Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>

                            <!-- Background update notice -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsBackgroundReminderSupported}">
                                <CheckBox Name="BackgroundUpdateNotifyCheckBox"
                                          Content="Tell me about new versions with a Windows notification when the app is closed"
                                          IsChecked="{Binding BackgroundUpdateNotifyEnabled}"/>
                                <TextBlock Text="Windows checks a few times a day and notifies you once per release. Clicking the notification opens the app, which offers the update."
                                           Margin="32,0,0,0"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>

                            <!-- Update Check Button -->
                            <Border Background="{DynamicResource AppSurfaceAlt}"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Button Command="{Binding CheckForUpdatesCommand}"
                                            Classes="primary"
                                            Background="{DynamicResource AppAccentFill}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="16,10"
                                            IsEnabled="{Binding !IsCheckingForUpdates}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <materialIcons:MaterialIcon Kind="Update" Width="16" Height="16"/>
                                            <TextBlock Text="Check for Updates" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Update Check Result -->
                                    <Border Background="{DynamicResource AppSurface}"
                                            CornerRadius="6"
                                            Padding="12"
                                            BorderBrush="{DynamicResource AppBorder}"
                                            BorderThickness="1"
                                            IsVisible="{Binding !!UpdateCheckResult}">
                                        <TextBlock Text="{Binding UpdateCheckResult}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource AppText}"
                                                  TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="2"
                  Background="#80000000"
                  IsVisible="{Binding IsLoading}">
                <Border Background="{DynamicResource AppSurface}"
                        CornerRadius="12"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <ProgressBar IsIndeterminate="True" 
                                    Width="200"
                                    Height="4"
                                    Background="{DynamicResource AppBorder}"
                                    Foreground="{DynamicResource AppAccent}"/>
                        <TextBlock Text="Saving settings..." 
                                  HorizontalAlignment="Center" 
                                  FontSize="14"
                                  Foreground="{DynamicResource AppTextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>