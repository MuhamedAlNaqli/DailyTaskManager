<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
             x:Class="DailyTaskManager.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Modern Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#FF2E3440"/>
                    <TextBlock Text="Configure application preferences and PDF export settings" 
                               FontSize="14" 
                               Foreground="#FF5E81AC" 
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            
            <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="24">
                    
                    <!-- PDF Export Settings -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📄" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="PDF Export Customization" 
                                               FontWeight="SemiBold" 
                                               FontSize="18"
                                               Foreground="#FF374151"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1"
                                        Command="{Binding SavePdfSettingsCommand}" 
                                        Classes="primary"
                                        Background="#FF4C566A"
                                        BorderBrush="Transparent"
                                        Foreground="White"
                                        CornerRadius="6"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="💾" FontSize="14"/>
                                        <TextBlock Text="Save PDF Settings"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column - Header Settings -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Header Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Foreground="#FF374151"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.CompanyName}"
                                             Watermark="Company Name"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.CompanyId}"
                                             Watermark="Company ID"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.AddressLine1}"
                                             Watermark="Address Line 1"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.AddressLine2}"
                                             Watermark="Address Line 2"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.Phone}"
                                             Watermark="Phone"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.Email}"
                                             Watermark="Email"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Right Column - Client & Document Settings -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Client and Document Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16" Foreground="#FF374151"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.ClientName}"
                                             Watermark="Client Name"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.ClientId}"
                                             Watermark="Client ID"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.DocumentTitle}"
                                             Watermark="Document Title"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <TextBox Text="{Binding PdfSettings.ContractPrefix}"
                                             Watermark="Contract Number Prefix"
                                             Background="White"
                                             BorderBrush="#FFD1D5DB"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             Padding="12,10"
                                             FontSize="14"
                                             Margin="0,0,0,12"/>
                                    
                                    <CheckBox Content="Show Company Logo Border"
                                              IsChecked="{Binding PdfSettings.ShowLogoBorder}"
                                              Margin="0,0,0,12"/>
                                    
                                    <CheckBox Content="Include Signature Section"
                                              IsChecked="{Binding PdfSettings.IncludeSignatures}"
                                              Margin="0,0,0,12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Preview Button -->
                            <Button Command="{Binding PreviewPdfCommand}" 
                                    Classes="secondary"
                                    Background="Transparent"
                                    BorderBrush="#FFBFDBFE"
                                    Foreground="#FF3B82F6"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16,10"
                                    HorizontalAlignment="Center"
                                    Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="👁️" FontSize="14"/>
                                    <TextBlock Text="Preview PDF"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Application Settings Section -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📱 Application Settings (Read-only)" 
                                       FontWeight="SemiBold" 
                                       FontSize="18"
                                       Foreground="#FF374151"
                                       Margin="0,0,0,16"/>
                            
                            <DataGrid ItemsSource="{Binding AppSettings}" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="True"
                                      Background="#FFF8FAFC"
                                      BorderBrush="#FFE2E8F0"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowBackground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Database Settings Section -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Padding="24" 
                            BorderBrush="#FFE2E8F0"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                           Text="🗃️ Database Settings" 
                                           FontWeight="SemiBold" 
                                           FontSize="18"
                                           Foreground="#FF374151"
                                           VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                    <Button Command="{Binding AddSettingCommand}" 
                                            Classes="secondary"
                                            Background="Transparent"
                                            BorderBrush="#FFBFDBFE"
                                            Foreground="#FF3B82F6"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="+" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Add"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button Command="{Binding SaveCommand}" 
                                            Classes="primary"
                                            Background="#FF4C566A"
                                            BorderBrush="Transparent"
                                            Foreground="White"
                                            CornerRadius="6"
                                            Padding="12,8"
                                            IsEnabled="{Binding HasDbSettings}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="💾" FontSize="14"/>
                                            <TextBlock Text="Save"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding DbSettings}" 
                                      AutoGenerateColumns="False" 
                                      IsReadOnly="False"
                                      Background="#FFF8FAFC"
                                      BorderBrush="#FFE2E8F0"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowBackground="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="2"
                  Background="#80000000"
                  IsVisible="{Binding IsLoading}">
                <Border Background="White"
                        CornerRadius="12"
                        Padding="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="16">
                        <ProgressBar IsIndeterminate="True" 
                                    Width="200"
                                    Height="4"
                                    Background="#FFE2E8F0"
                                    Foreground="#FF3B82F6"/>
                        <TextBlock Text="Saving settings..." 
                                  HorizontalAlignment="Center" 
                                  FontSize="14"
                                  Foreground="#FF6B7280"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>