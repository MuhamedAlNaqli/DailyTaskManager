<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:vm="using:DailyTaskManager.Avalonia.ViewModels"
             xmlns:models="using:DailyTaskManager.Core.Models"
             x:Class="DailyTaskManager.Avalonia.Views.ClientsSettingsView"
             x:DataType="vm:ClientsViewModel">

    <Border Background="{DynamicResource AppSurface}"
            CornerRadius="12"
            Padding="24"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1">
        <StackPanel Spacing="16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <materialIcons:MaterialIcon Kind="AccountGroup" Width="20" Height="20" Foreground="{DynamicResource AppAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="Clients" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AppTextStrong}"/>
                </StackPanel>
                <TextBlock Text="Each client has its own company details, contract and folder for documents. The details are printed on that client's work orders and invoices."
                           TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource AppTextMuted}"/>
            </StackPanel>

            <Grid ColumnDefinitions="220,24,*">
                <!-- Client list -->
                <StackPanel Spacing="10">
                    <Button Name="NewClientButton" Command="{Binding NewClientCommand}" Classes="primary" Padding="12,8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/>
                            <TextBlock Text="New client"/>
                        </StackPanel>
                    </Button>
                    <ListBox Name="ClientsList" AutoScrollToSelectedItem="False" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" MaxHeight="360">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Client">
                                <StackPanel Spacing="2" Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Inactive" FontSize="11" Foreground="{DynamicResource AppTextMuted}" IsVisible="{Binding !IsActive}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No clients yet. Add one to print its details on your documents."
                               IsVisible="{Binding !IsEditing}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                </StackPanel>

                <!-- Editor -->
                <StackPanel Grid.Column="2" Spacing="14" IsVisible="{Binding IsEditing}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextStrong}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Name="PreviewClientButton" Command="{Binding PreviewCommand}" IsEnabled="{Binding CanDelete}" Classes="secondary" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="16" Height="16"/>
                                    <TextBlock Text="Preview work order"/>
                                </StackPanel>
                            </Button>
                            <Button Name="DeleteClientButton" Command="{Binding DeleteClientCommand}" IsEnabled="{Binding CanDelete}" Classes="danger" Padding="14,8">
                                <TextBlock Text="Delete"/>
                            </Button>
                            <Button Name="SaveClientButton" Command="{Binding SaveClientCommand}" Classes="primary" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16"/>
                                    <TextBlock Text="Save client"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                        <StackPanel Spacing="6"><TextBlock Text="Client name (short, shown in lists)" Classes="label"/><TextBox Name="ClientNameBox" Classes="form" Text="{Binding Name}"/></StackPanel>
                        <StackPanel Spacing="6" Grid.Column="2"><TextBlock Text="Company name on documents" Classes="label"/><TextBox Name="ClientLegalNameBox" Classes="form" Text="{Binding LegalName}"/></StackPanel>
                        <StackPanel Spacing="6" Grid.Row="1"><TextBlock Text="Company ID" Classes="label"/><TextBox Name="ClientCompanyIdBox" Classes="form" Text="{Binding CompanyId}"/></StackPanel>
                        <StackPanel Spacing="6" Grid.Row="1" Grid.Column="2"><TextBlock Text="VAT number" Classes="label"/><TextBox Name="ClientVatBox" Classes="form" Text="{Binding VatNumber}"/></StackPanel>
                        <StackPanel Spacing="6" Grid.Row="2"><TextBlock Text="Address line 1" Classes="label"/><TextBox Name="ClientAddress1Box" Classes="form" Text="{Binding AddressLine1}"/></StackPanel>
                        <StackPanel Spacing="6" Grid.Row="2" Grid.Column="2"><TextBlock Text="Address line 2" Classes="label"/><TextBox Name="ClientAddress2Box" Classes="form" Text="{Binding AddressLine2}"/></StackPanel>
                        <StackPanel Grid.Row="3" Spacing="6">
                            <TextBlock Text="Currency" Classes="label"/>
                            <ComboBox Name="ClientCurrencyComboBox" Classes="form" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Spacing="6" VerticalAlignment="Bottom">
                            <CheckBox Name="ClientActiveCheckBox" Content="Active (offered for new entries)" IsChecked="{Binding IsActive}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Folder for this client's documents" Classes="label"/>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Name="ClientFolderBox" Classes="filled" Text="{Binding ExportFolder}" Watermark="Empty = the default export folders" IsReadOnly="True"/>
                            <Button Name="BrowseClientFolderButton" Grid.Column="1" Command="{Binding BrowseFolderCommand}" Classes="secondary" Padding="12,8">
                                <TextBlock Text="Browse"/>
                            </Button>
                            <Button Name="ClearClientFolderButton" Grid.Column="2" Command="{Binding ClearFolderCommand}" Classes="secondary" Padding="12,8">
                                <TextBlock Text="Clear"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6"><TextBlock Text="Notes" Classes="label"/><TextBox Name="ClientNotesBox" Classes="form" Text="{Binding Notes}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"/></StackPanel>

                    <!-- Contracts -->
                    <StackPanel Spacing="10" IsVisible="{Binding CanEditContracts}">
                        <Rectangle Height="1" Fill="{DynamicResource AppBorder}"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Contracts" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AppTextStrong}"/>
                                <TextBlock Text="The contract valid in a month supplies the number on that month's documents. Adding a contract ends the open one the day before."
                                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            </StackPanel>
                            <Button Name="NewContractButton" Grid.Column="1" Command="{Binding NewContractCommand}" Classes="secondary" Padding="12,6" VerticalAlignment="Top">
                                <TextBlock Text="New contract"/>
                            </Button>
                        </Grid>

                        <ListBox Name="ContractsList" AutoScrollToSelectedItem="False" ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" MaxHeight="150">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ContractRow">
                                    <Grid ColumnDefinitions="140,*,Auto" Margin="2,4">
                                        <TextBlock Text="{Binding Number}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Period}" Foreground="{DynamicResource AppTextMuted}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Rate}" Foreground="{DynamicResource AppTextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                            <StackPanel Spacing="6"><TextBlock Text="Contract number, e.g. 078-01" Classes="label"/><TextBox Name="ContractNumberBox" Classes="form" Text="{Binding ContractNumber}"/></StackPanel>
                            <TextBox Name="ContractRateBox" Grid.Column="2" Classes="filled" Text="{Binding ContractRate}" Watermark="Hourly rate (optional)"/>
                            <DatePicker Name="ContractFromPicker" Grid.Column="4" Classes="form" SelectedDate="{Binding ContractFrom, Mode=TwoWay}"/>
                            <DatePicker Name="ContractToPicker" Grid.Column="6" Classes="form" SelectedDate="{Binding ContractTo, Mode=TwoWay}"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                            <TextBlock Grid.Column="4" Text="Valid from" FontSize="12" Foreground="{DynamicResource AppTextMuted}"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Valid to" FontSize="12" Foreground="{DynamicResource AppTextMuted}" VerticalAlignment="Center"/>
                                <Button Name="ClearContractToButton" Command="{Binding ClearContractToCommand}" Classes="secondary" Padding="8,2" FontSize="12">
                                    <TextBlock Text="Open-ended"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Name="SaveContractButton" Command="{Binding SaveContractCommand}" Classes="primary" Padding="14,8">
                                <TextBlock Text="Save contract"/>
                            </Button>
                            <Button Name="DeleteContractButton" Command="{Binding DeleteContractCommand}" Classes="danger" Padding="14,8">
                                <TextBlock Text="Delete contract"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
