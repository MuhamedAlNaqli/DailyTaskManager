<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Button Styles -->
    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Red"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="Red"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="Red"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Card-like containers -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
    </Style>

    <!-- Header text styles -->
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.subheader">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Loading overlay -->
    <Style Selector="Grid.loading-overlay">
        <Setter Property="Background" Value="#80000000"/>
        <Setter Property="ZIndex" Value="1000"/>
    </Style>

    <!-- Data Grid styling -->
    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="RowBackground" Value="{DynamicResource MaterialDesignPaper}"/>
    </Style>

    <!-- Icon button style -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <!-- Navigation buttons -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.nav:checked">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
    </Style>

    <!-- Form field styles -->
    <Style Selector="TextBox.field">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="DatePicker.field">
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <!-- Status indicators -->
    <Style Selector="Border.status-success">
        <Setter Property="Background" Value="#4CAF50"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-warning">
        <Setter Property="Background" Value="#FF9800"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-error">
        <Setter Property="Background" Value="#F44336"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Animation styles -->
    <Style Selector="Control.fade-in">
        <Style.Animations>
            <Animation Duration="0:0:0.3">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Responsive design helpers -->
    <Style Selector="StackPanel.responsive-horizontal">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <!-- Mobile/tablet adjustments would go here -->
    <Style Selector="StackPanel.responsive-horizontal[IsEffectivelyEnabled=false]">
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

</Styles>