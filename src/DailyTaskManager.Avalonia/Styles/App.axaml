<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assist="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:materialIcons="using:Material.Icons.Avalonia">

    <!-- Typography and page background -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    </Style>
    <Style Selector="TemplatedControl">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
    </Style>

    <!-- Buttons: flat, rounded, brand coloured -->
    <Style Selector="Button, DropDownButton">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="assist:ShadowAssist.ShadowDepth" Value="Depth0"/>
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccent}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Text on a brand-coloured button is always light, in both themes -->
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccent}"/>
    </Style>
    <Style Selector="Button.primary materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccent}"/>
    </Style>

    <Style Selector="Button.secondary, DropDownButton.secondary">
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppDanger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AppDanger}"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppDangerSoft}"/>
    </Style>

    <!-- Card-like containers -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- Header text styles -->
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.subheader">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Loading overlay -->
    <Style Selector="Grid.loading-overlay">
        <Setter Property="Background" Value="{DynamicResource AppOverlay}"/>
        <Setter Property="ZIndex" Value="1000"/>
    </Style>

    <!-- Icon button style -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
    </Style>

    <!-- Form field styles -->
    <Style Selector="TextBox.field">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="DatePicker.field">
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <!-- Theme-safe input control styles to ensure text readability -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppInputText}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentSoftBorder}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AppTextStrong}"/>
    </Style>
    
    <!-- DatePicker text readability -->
    <Style Selector="DatePicker /template/ TextBox">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppInputText}"/>
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
    </Style>
    
    <!-- DatePicker button styling for classic calendar popup -->
    <Style Selector="DatePicker /template/ Button">
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CornerRadius" Value="0,8,8,0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Button:pressed">
        <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
    </Style>
    
    <!-- Enhanced DatePicker styling for better visual feedback -->
    <Style Selector="DatePicker">
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <!-- DatePicker calendar popup improvements -->
    <Style Selector="DatePicker /template/ Popup">
        <Setter Property="PlacementGravity" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="4"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Calendar">
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    
    <!-- DatePicker watermark styling -->
    <Style Selector="DatePicker /template/ TextBox:placeholder">
        <Setter Property="Foreground" Value="{DynamicResource AppTextFaint}"/>
    </Style>
    
    <!-- Drop-downs look like the filled text boxes and keep readable text inside popups and flyouts -->
    <Style Selector="ComboBox">
        <Setter Property="Theme" Value="{DynamicResource MaterialFilledComboBox}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="PlaceholderForeground" Value="{DynamicResource AppTextMuted}"/>
    </Style>
    <Style Selector="ComboBox TextBlock, ComboBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
    </Style>
    <Style Selector="ComboBox /template/ TextBlock#floatingWatermark, ComboBox /template/ TextBlock#PART_PlaceholderText">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>

    <!-- Form dialogs: labels, section titles and one height for every input so the rows line up -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AppDanger}"/>
    </Style>
    <Style Selector="TextBox.form, ComboBox.form, NumericUpDown.form">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="DatePicker.form">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="assist:TextFieldAssist.Label" Value=""/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DatePicker.form /template/ TextBox#DisplayTextBox">
        <Setter Property="Theme" Value="{DynamicResource FilledTextBox}"/>
        <Setter Property="UseFloatingWatermark" Value="False"/>
        <Setter Property="MinHeight" Value="48"/>
    </Style>
    <Style Selector="Button.dialog">
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <!-- ComboBox text readability -->
    <Style Selector="ComboBox /template/ TextBox">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AppInputText}"/>
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
    </Style>

    <!-- Calendar (date pickers and the date-range flyout) must follow the theme -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{DynamicResource AppInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
    </Style>
    <Style Selector="Calendar CalendarDayButton, Calendar CalendarButton, Calendar Button">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
    </Style>
    <Style Selector="Calendar CalendarDayButton:pointerover, Calendar CalendarButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>
    <Style Selector="Calendar TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppInputText}"/>
    </Style>
    
    <!-- Global input control overrides to ensure readability -->
    <Style Selector="TextBox, DatePicker, ComboBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- Status indicators -->
    <Style Selector="Border.status-success">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-warning">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-error">
        <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Animation styles -->
    <Style Selector="Control.fade-in">
        <Style.Animations>
            <Animation Duration="0:0:0.3">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Responsive design helpers -->
    <Style Selector="StackPanel.responsive-horizontal">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <!-- Mobile/tablet adjustments would go here -->
    <Style Selector="StackPanel.responsive-horizontal[IsEffectivelyEnabled=false]">
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

    <!-- Sidebar navigation: icon + label, the current page is tinted with the brand colour -->
    <Style Selector="Button.sidebar-nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource AppText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="Button.sidebar-nav:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>

    <Style Selector="Button.sidebar-nav:pressed">
        <Setter Property="Background" Value="{DynamicResource AppPressed}"/>
    </Style>

    <Style Selector="Button.sidebar-nav.active">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.sidebar-nav.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
    </Style>

    <Style Selector="Button.sidebar-nav.quiet">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>

    <!-- View switch (week / list) -->
    <Style Selector="Button.segment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>
    <Style Selector="Button.segment:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
    </Style>
    <Style Selector="Button.segment.active">
        <Setter Property="Background" Value="{DynamicResource AppAccentFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccent}"/>
    </Style>
    <Style Selector="Button.segment.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccent}"/>
    </Style>

    <!-- Week view -->
    <Style Selector="Border.day-column">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="MinHeight" Value="380"/>
    </Style>
    <Style Selector="Border.day-column.weekend">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}"/>
    </Style>
    <Style Selector="Border.day-column.today">
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="TextBlock.day-name">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
    </Style>
    <Style Selector="TextBlock.day-date">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
    </Style>
    <Style Selector="Border.day-column.today TextBlock.day-name, Border.day-column.today TextBlock.day-date">
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
    </Style>
    <Style Selector="Border.week-entry">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="Button.entry-text">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
    </Style>
    <Style Selector="Button.add-day">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.add-day:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppHover}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
    </Style>
    <Style Selector="Button.icon.mini">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Help page -->
    <Style Selector="Border.help-card">
        <Setter Property="Background" Value="{DynamicResource AppSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style Selector="Grid.help-row">
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style Selector="Border.key-cap">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1,1,1,2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style Selector="TextBlock.key-cap-text">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextStrong}"/>
    </Style>

</Styles>
