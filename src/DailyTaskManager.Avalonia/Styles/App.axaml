<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Custom Button Styles -->
    <Style Selector="Button.primary">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Red"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="Red"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="Red"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Card-like containers -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="16"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BoxShadow" Value="0 2 8 0 #40000000"/>
    </Style>

    <!-- Header text styles -->
    <Style Selector="TextBlock.header">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style Selector="TextBlock.subheader">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Loading overlay -->
    <Style Selector="Grid.loading-overlay">
        <Setter Property="Background" Value="#80000000"/>
        <Setter Property="ZIndex" Value="1000"/>
    </Style>

    <!-- Data Grid styling -->
    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
        <Setter Property="RowBackground" Value="{DynamicResource MaterialDesignPaper}"/>
    </Style>

    <!-- Icon button style -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <!-- Navigation buttons -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="Margin" Value="8,2"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Button.nav:checked">
        <Setter Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
    </Style>

    <!-- Form field styles -->
    <Style Selector="TextBox.field">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="BorderBrush" Value="Gray"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style Selector="DatePicker.field">
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <!-- Theme-safe input control styles to ensure text readability -->
    <Style Selector="TextBox">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
        <Setter Property="SelectionBrush" Value="#3390FF"/>
        <Setter Property="SelectionForegroundBrush" Value="White"/>
    </Style>
    
    <!-- DatePicker text readability -->
    <Style Selector="DatePicker /template/ TextBox">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    
    <!-- DatePicker button styling for classic calendar popup -->
    <Style Selector="DatePicker /template/ Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CornerRadius" Value="0,8,8,0"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Button:pointerover">
        <Setter Property="Background" Value="#F3F4F6"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Button:pressed">
        <Setter Property="Background" Value="#E5E7EB"/>
    </Style>
    
    <!-- Enhanced DatePicker styling for better visual feedback -->
    <Style Selector="DatePicker">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
    <!-- DatePicker calendar popup improvements -->
    <Style Selector="DatePicker /template/ Popup">
        <Setter Property="PlacementGravity" Value="Bottom"/>
        <Setter Property="VerticalOffset" Value="4"/>
    </Style>
    
    <Style Selector="DatePicker /template/ Calendar">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="8"/>
    </Style>
    
    <!-- DatePicker watermark styling -->
    <Style Selector="DatePicker /template/ TextBox:placeholder">
        <Setter Property="Foreground" Value="#FF9CA3AF"/>
    </Style>
    
    <!-- ComboBox text readability -->
    <Style Selector="ComboBox /template/ TextBox">
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="CaretBrush" Value="Black"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    
    <!-- Global input control overrides to ensure readability -->
    <Style Selector="TextBox, DatePicker, ComboBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <!-- Status indicators -->
    <Style Selector="Border.status-success">
        <Setter Property="Background" Value="#4CAF50"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-warning">
        <Setter Property="Background" Value="#FF9800"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="Border.status-error">
        <Setter Property="Background" Value="#F44336"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- Animation styles -->
    <Style Selector="Control.fade-in">
        <Style.Animations>
            <Animation Duration="0:0:0.3">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Responsive design helpers -->
    <Style Selector="StackPanel.responsive-horizontal">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Spacing" Value="10"/>
    </Style>

    <!-- Mobile/tablet adjustments would go here -->
    <Style Selector="StackPanel.responsive-horizontal[IsEffectivelyEnabled=false]">
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

    <!-- Sidebar Navigation Styles -->
    <Style Selector="Button.sidebar-nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.sidebar-nav:pointerover">
        <Setter Property="Background" Value="#FFF3F4F6"/>
    </Style>

    <Style Selector="Button.sidebar-nav:pressed">
        <Setter Property="Background" Value="#FFE5E7EB"/>
    </Style>

    <!-- Active state for sidebar navigation -->
    <Style Selector="Button.sidebar-nav.active">
        <Setter Property="Background" Value="#FFF3F4F6"/>
    </Style>

    <Style Selector="Button.sidebar-nav.active TextBlock">
        <Setter Property="Foreground" Value="#FF374151"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</Styles>