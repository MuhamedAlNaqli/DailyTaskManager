<!-- Version 2.2.1 - Latest Release -->
        <item>
            <title>Daily Task Manager 2.2.1</title>
            <sparkle:version>2.2.1.0</sparkle:version>
            <sparkle:shortVersionString>2.2.1</sparkle:shortVersionString>
            <description><![CDATA[
                <h3>Daily Task Manager 2.2.1</h3>
                <p><strong>Key Features:</strong></p>
                <ul>
                    <li>Cross-platform Avalonia UI application</li>
                    <li>PostgreSQL database support with Entity Framework Core</li>
                    <li>Google OAuth2 authentication</li>
                    <li>Modern MVVM architecture with dependency injection</li>
                    <li>Automatic update system with NetSparkleUpdater</li>
                    <li>Professional MSI installer with automated versioning</li>
                </ul>
                <p><strong>Technical Details:</strong></p>
                <ul>
                    <li>Framework: .NET 8</li>
                    <li>UI Framework: Avalonia 11.3.3</li>
